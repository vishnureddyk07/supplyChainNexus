# Local development only. Replace all values before any shared or production use.
POSTGRES_USER=supplychain
POSTGRES_PASSWORD=replace-with-a-local-development-password
POSTGRES_DB=supplychain
POSTGRES_HOST_PORT=5432

KAFKA_HOST_PORT=9092
KAFKA_ADVERTISED_HOST=localhost
ZOOKEEPER_HOST_PORT=2181
MQTT_HOST_PORT=1883
ERP_HOST_PORT=8000
API_HOST_PORT=8001
FRONTEND_HOST_PORT=5173
CORS_ORIGINS=http://localhost:5173
APP_ENV=development

# Optional local development API auth. Configure distinct secrets for shared use.
API_VIEWER_TOKEN=
API_OPERATOR_TOKEN=
API_ADMIN_TOKEN=
# Legacy single-token setting grants administrator access; prefer role-specific tokens.
API_AUTH_TOKEN=

NEO4J_USER=neo4j
NEO4J_PASSWORD=replace-with-a-local-development-password
NEO4J_HTTP_HOST_PORT=7474
NEO4J_BOLT_HOST_PORT=7687

DEPENDENCY_STARTUP_TIMEOUT_SECONDS=120
EVENT_INTERVAL=5
SCENARIO_MODE=normal
LOG_LEVEL=INFO

SUPPLIER_RISK_LABEL_SOURCES=manual,audited
SUPPLIER_RISK_MODEL_PATH=model-artifacts/supplier-risk-rf.skops
SHIPMENT_DELAY_MODEL_PATH=model-artifacts/shipment-delay.txt
COMPOSITE_RISK_VERSION=composite-risk-v1
COMPOSITE_RISK_MINIMUM_COVERAGE=0.5
SHIPMENT_DELAY_RISK_HORIZON_HOURS=24
COMPOSITE_RISK_WEIGHTS={"supplier_model_risk":0.4,"disruption_pressure":0.2,"telemetry_pressure":0.2,"supplier_status_risk":0.1,"shipment_delay_risk":0.1}

# Azure OpenAI is optional; recommendations report unavailable when unset.
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_DEPLOYMENT=
AZURE_OPENAI_API_VERSION=2024-10-21

# Isolated local demo stack. Requires `docker compose --profile demo up`.
DEMO_POSTGRES_USER=supplychain_demo
DEMO_POSTGRES_PASSWORD=replace-with-a-demo-only-password
DEMO_POSTGRES_DB=supplychain_demo
DEMO_POSTGRES_HOST_PORT=5433
DEMO_NEO4J_PASSWORD=replace-with-a-demo-only-password
DEMO_NEO4J_HTTP_HOST_PORT=7475
DEMO_NEO4J_BOLT_HOST_PORT=7688
DEMO_API_HOST_PORT=8002
DEMO_FRONTEND_HOST_PORT=5174
