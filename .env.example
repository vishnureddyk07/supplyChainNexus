# Ingestion service
KAFKA_BOOTSTRAP_SERVERS=kafka:9092
MQTT_BROKER=mosquitto
MQTT_PORT=1883
MQTT_TOPIC=suppliers/+/telemetry
SUPPLIER_ERP_URL=http://supplier-erp-mock:8000
OPENWEATHER_LOCATIONS=51.9244,4.4777
GDELT_QUERY=supply chain OR shipping

# Optional external API credentials
MARINETRAFFIC_API_KEY=
OPENWEATHER_API_KEY=

# Schema validation and service observability
INGESTION_ENV=local
SCHEMA_REGISTRY_URL=http://localhost:8081
SCHEMA_REGISTRY_REQUIRED=false
INGESTION_PORT=8080

# Graph and local platform defaults
NEO4J_USER=neo4j
NEO4J_PASSWORD=password
GRAPH_MAX_RETRIES=3
